<mxCell id="n2" value="Enfermería aplica escala validada de&#xa;riesgo tromboembólico (Padua o Caprini)&#xa;dentro de las primeras 24 h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="450" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="n3" value="Considerar factores de riesgo:&#xa;inmovilidad, contención mecánica prolongada,&#xa;condiciones clínicas, edad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="570" width="320" height="70" as="geometry"/></mxCell>
