      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h" value="A-12 · Valoración nutricional del paciente hospitalizado&#xa;Estándar 12/23 — Eje A. Valoración (Necesario) — Responsable: Nutrición&#xa;Hospital de Salud Mental Orizaba — MOCEBPASS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="760" height="75" as="geometry"/></mxCell>
<mxCell id="ini" value="INICIO" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="135" width="140" height="50" as="geometry"/></mxCell>
<mxCell id="n1" value="Enfermería notifica el ingreso a Nutrición&#xa;(vale de ingreso HSMOND-000: nombre, hora,&#xa;fecha, área, dieta indicada al ingreso)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="215" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="n2" value="Nutrición registra ingreso en censo digital&#xa;y acude a valorar al paciente&#xa;(primeras 24 h)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="320" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="d1" value="¿Paciente en condiciones&#xa;de ser evaluado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="425" width="320" height="85" as="geometry"/></mxCell>
<mxCell id="alt1" value="No apto: elaborar nota que evidencia&#xa;que se acudió, integrar a expediente&#xa;y regresar cuando esté disponible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="565" y="430" width="235" height="75" as="geometry"/></mxCell>
<mxCell id="n3" value="Presentación con el paciente:&#xa;verificar identidad e informar objetivos,&#xa;beneficios e importancia de participar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="560" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="n4" value="Medición de peso y talla (antropometría)&#xa;con apoyo del acompañante terapéutico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="660" width="320" height="60" as="geometry"/></mxCell>
<mxCell id="n5" value="Realizar evaluación nutricional inicial y&#xa;tamizaje nutricional; anotar en Nota de&#xa;nutrición HSMOND-008" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="760" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="d2" value="¿Tamizaje positivo&#xa;(riesgo nutricional)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="870" width="320" height="85" as="geometry"/></mxCell>
<mxCell id="alt2" value="Sin riesgo: registrar resultado&#xa;en Nota HSMOND-008&#xa;e integrar a expediente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="565" y="875" width="235" height="70" as="geometry"/></mxCell>
<mxCell id="n6" value="Evaluación nutricional exhaustiva:&#xa;patologías de alto gasto metabólico,&#xa;trastornos de deglución, restricciones,&#xa;efectos metabólicos de antipsicóticos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="1010" width="320" height="85" as="geometry"/></mxCell>
<mxCell id="n7" value="Elaborar historia nutricional HSMOND-000&#xa;y plan de alimentación en Nota HSMOND-008&#xa;(original al expediente clínico)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="1130" width="320" height="75" as="geometry"/></mxCell>
<mxCell id="n8" value="Enfermería solicita/ajusta dieta con el&#xa;médico mediante Vale de dieta HSMOND-000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="1250" width="320" height="60" as="geometry"/></mxCell>
