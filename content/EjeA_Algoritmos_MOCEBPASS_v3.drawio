<mxCell id="n2" value="Clasificar tipo de barrera:&#xa;Geográfica · Económica · Lingüística&#xa;Comunicativa · Administrativa&#xa;Estigma / Actitudinal · Disponibilidad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="440" width="320" height="85" as="geometry"/></mxCell>
<mxCell id="n3" value="Aplicar intervención específica:&#xa;• Geográfica: gestionar transporte/referencia&#xa;• Económica: exención / apoyo social&#xa;• Lingüística: intérprete / LSM&#xa;• Administrativa: Cero Rechazo&#xa;• Estigma: trato digno y no discriminatorio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="560" width="320" height="100" as="geometry"/></mxCell>
<mxCell id="n4" value="Registrar en expediente:&#xa;tipo de barrera, intervención aplicada&#xa;y nombre del responsable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="680" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="d2" value="¿La barrera fue resuelta&#xa;para garantizar la atención?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="780" width="320" height="85" as="geometry"/></mxCell>
<mxCell id="alt2" value="Barrera no resuelta:&#xa;escalar a Jefatura inmediatamente&#xa;Política de Cero Rechazo aplica" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="565" y="785" width="235" height="70" as="geometry"/></mxCell>
<mxCell id="n5" value="Brindar atención sin demora&#xa;(Política de Cero Rechazo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="900" width="320" height="60" as="geometry"/></mxCell>
<mxCell id="n6" value="Notificar a equipo multidisciplinario:&#xa;Trabajo Social, Psicología, Médico&#xa;para seguimiento del caso" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="1000" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="n7" value="Seguimiento en próximo contacto:&#xa;verificar resolución de barrera&#xa;y registrar resultado en expediente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="1100" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="n8" value="Análisis multidisciplinario trimestral:&#xa;revisar barreras frecuentes, indicadores&#xa;y efectividad de intervenciones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="1200" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="n9" value="Documentar en minuta y actualizar&#xa;política / lineamiento institucional&#xa;de reducción de barreras" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="1310" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="doc1" value="Minuta de análisis trimestral&#xa;(evidencia clave para auditoría)" style="shape=document;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="1210" width="165" height="55" as="geometry"/></mxCell>
