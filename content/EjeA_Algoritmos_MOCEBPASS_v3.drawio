<mxCell id="n1" value="Paciente adulto ingresa a hospitalización" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="215" width="320" height="55" as="geometry"/></mxCell>
