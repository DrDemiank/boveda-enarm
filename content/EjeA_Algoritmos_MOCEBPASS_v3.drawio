<diagram name="A-13 Valores, costumbres y creencias">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10"
                  guides="1" tooltips="1" connect="1" arrows="1"
                  fold="1" page="1" pageScale="1"
                  pageWidth="1100" pageHeight="1700"
                  background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h" value="A-13 · Valoración de valores, costumbres y creencias del paciente&#xa;Estándar 13/23 — Eje A. Valoración (Necesario) — Responsable: Médico y Trabajo Social&#xa;Hospital de Salud Mental Orizaba — MOCEBPASS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="760" height="75" as="geometry"/></mxCell>
<mxCell id="ini" value="INICIO" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="135" width="140" height="50" as="geometry"/></mxCell>
<mxCell id="n1" value="Paciente ingresa al HSMO&#xa;— valoración inicial en curso&#xa;(Médico / Trabajo Social)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="215" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="n2" value="Explorar e identificar con el paciente y familia:&#xa;valores (autonomía, dignidad, decisiones familiares,&#xa;actitudes hacia dolor/enfermedad/final de la vida),&#xa;costumbres (rituales, alimentación, horarios,&#xa;participación familiar, medicina tradicional),&#xa;creencias espirituales/religiosas/filosóficas&#xa;(transfusiones, medicamentos, ayuno)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="305" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="d1" value="¿Contenido religioso o&#xa;cultural de difícil&#xa;delimitación?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="445" width="320" height="95" as="geometry"/></mxCell>
<mxCell id="alt1" value="Médico psiquiatra define&#xa;el carácter (creencia cultural&#xa;vs. sintomatología psicótica)&#xa;y lo documenta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="565" y="450" width="235" height="80" as="geometry"/></mxCell>
<mxCell id="n3" value="Documentar la valoración en la historia&#xa;clínica, en un lugar accesible para el&#xa;equipo, en el marco de tiempo definido" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="585" width="320" height="70" as="geometry"/></mxCell>
