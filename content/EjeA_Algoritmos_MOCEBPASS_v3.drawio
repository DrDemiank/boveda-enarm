        <mxCell id="h" value="A-11 · Valoración del riesgo de enfermedad tromboembólica venosa en pacientes hospitalizados&#xa;Estándar 11/23 — Eje A. Valoración (Necesario) — Responsable: Enfermería&#xa;Hospital de Salud Mental Orizaba — MOCEBPASS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="760" height="75" as="geometry"/></mxCell>
