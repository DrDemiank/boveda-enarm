  <diagram name="A-6 Historia clínica">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10"
                  guides="1" tooltips="1" connect="1" arrows="1"
                  fold="1" page="1" pageScale="1"
                  pageWidth="1100" pageHeight="1700"
                  background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h" value="A-6 · Historia clínica como parte de la valoración inicial del paciente&#xa;Estándar 6/23 — Eje A. Valoración (Necesario)&#xa;Hospital de Salud Mental Orizaba — MOCEBPASS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="760" height="75" as="geometry"/></mxCell>
<mxCell id="ini" value="INICIO" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="135" width="140" height="50" as="geometry"/></mxCell>
<mxCell id="n1" value="Paciente ingresa; definir ámbito (Médico de urgencias)&#xa;(hospitalización, urgencias o ambulatorio)&#xa;y plazo institucional de la historia clínica" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="215" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="d1" value="¿La elabora médico competente&#xa;o médico en formación?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="315" width="320" height="85" as="geometry"/></mxCell>
<mxCell id="alt1" value="Médico en formación:&#xa;elabora bajo supervisión&#xa;y validación del médico responsable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="565" y="320" width="235" height="75" as="geometry"/></mxCell>
<mxCell id="n2" value="Registrar elementos a) - c):&#xa;a) Datos de identificación&#xa;b) Interrogatorio&#xa;c) Exploración física" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="440" width="320" height="85" as="geometry"/></mxCell>
<mxCell id="n3" value="Registrar elementos d) - f):&#xa;d) Factores de riesgo social&#xa;e) Valores, creencias y costumbres&#xa;f) Factores de riesgo psicológico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="560" width="320" height="85" as="geometry"/></mxCell>
<mxCell id="n4" value="Registrar elementos g) - h):&#xa;g) Resultados de laboratorio, gabinete&#xa;y otros estudios (previos y actuales)&#xa;h) Diagnósticos o problemas clínicos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="680" width="320" height="85" as="geometry"/></mxCell>
<mxCell id="n5" value="Registrar elementos i) - k):&#xa;i) Pronóstico&#xa;j) Indicación terapéutica inicial&#xa;k) Nombre completo, cédula y firma del médico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="800" width="320" height="85" as="geometry"/></mxCell>
<mxCell id="d2" value="¿Servicio especializado&#xa;(p. ej. hemodiálisis)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="920" width="320" height="85" as="geometry"/></mxCell>
<mxCell id="alt2" value="Integrar estudios complementarios l)-r):&#xa;serología viral, BHC, electrolitos,&#xa;QS, depuración creatinina, Rx tórax, ECG&#xa;(plazos q-r según urgencia y riesgo-beneficio)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="565" y="925" width="235" height="90" as="geometry"/></mxCell>
<mxCell id="n6" value="Verificar integración de estudios&#xa;complementarios cuando aplique" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="1045" width="320" height="60" as="geometry"/></mxCell>
<mxCell id="d3" value="¿HC completada dentro&#xa;del plazo definido?&#xa;(24 h hospitalización)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="1145" width="320" height="90" as="geometry"/></mxCell>
<mxCell id="alt3" value="Completar a la brevedad&#xa;según estado clínico del paciente&#xa;y justificar en expediente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="565" y="1150" width="235" height="75" as="geometry"/></mxCell>
<mxCell id="n7" value="Integrar la historia clínica&#xa;al expediente clínico del paciente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="1270" width="320" height="60" as="geometry"/></mxCell>
<mxCell id="n8" value="Historia clínica disponible&#xa;para el equipo de salud" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="1370" width="320" height="60" as="geometry"/></mxCell>
<mxCell id="doc1" value="Historia clínica completa,&#xa;fechada y firmada en expediente&#xa;(evidencia auditable)" style="shape=document;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="1275" width="165" height="60" as="geometry"/></mxCell>
