  <diagram name="A-5 ⭐ Valoración inicial">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10"
                  guides="1" tooltips="1" connect="1" arrows="1"
                  fold="1" page="1" pageScale="1"
                  pageWidth="1100" pageHeight="1700"
                  background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h" value="A-5 ⭐ · Valoración inicial del paciente — INDISPENSABLE&#xa;Estándar 5/23 — Eje A. Valoración&#xa;Hospital de Salud Mental Orizaba — MOCEBPASS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="760" height="75" as="geometry"/></mxCell>
<mxCell id="ini" value="INICIO" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="135" width="140" height="50" as="geometry"/></mxCell>
<mxCell id="n1" value="Paciente ingresa al establecimiento&#xa;(hospitalización, urgencias o CE)&#xa;Iniciar valoración en primeras 24 h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="215" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="n2" value="Historia clínica integral:&#xa;ID, AHF, APNP, APP, padecimiento actual,&#xa;interrogatorio por aparatos y sistemas,&#xa;tóxicos, ginecoobstétricos, terapéutica previa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="315" width="320" height="85" as="geometry"/></mxCell>
<mxCell id="n3" value="Exploración física y neurológica:&#xa;TA, FC, FR, T°, SpO₂, peso, talla, IMC&#xa;Lesiones físicas o signos de maltrato" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="415" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="n4" value="Evaluación del estado mental:&#xa;conciencia, orientación, atención, memoria,&#xa;lenguaje, pensamiento, afecto, juicio&#xa;→ Impresión diagnóstica CIE-10 / DSM-5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="515" width="320" height="85" as="geometry"/></mxCell>
<mxCell id="n5" value="Riesgo de caídas — Escala de Morse:&#xa;Bajo &lt;25 · Moderado 25-44 · Alto ≥45&#xa;Implementar medidas según nivel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="615" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="n6" value="Riesgo lesiones por presión — Braden:&#xa;Si puntaje ≤18: activar medidas preventivas&#xa;Reevaluar cada 24 h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="715" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="n7" value="Tamizaje nutricional:&#xa;MST (adultos) / MNA (adultos mayores)&#xa;Registrar peso, talla, IMC, ingesta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="815" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="d1" value="¿Tamizaje nutricional&#xa;positivo?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="915" width="320" height="80" as="geometry"/></mxCell>
<mxCell id="alt1" value="Solicitar interconsulta&#xa;a Nutrición en primeras 24 h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="565" y="920" width="235" height="55" as="geometry"/></mxCell>
<mxCell id="n8" value="Valoración del dolor:&#xa;EVN 0-10 (comunicación conservada)&#xa;PAINAD / Abbey (deterioro cognitivo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="1020" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="d2" value="¿Dolor ≥ 4?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="1120" width="320" height="80" as="geometry"/></mxCell>
<mxCell id="alt2" value="Iniciar manejo analgésico&#xa;y reevaluar en 30 minutos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="565" y="1125" width="235" height="55" as="geometry"/></mxCell>
<mxCell id="n9" value="Factores de riesgo psicológico:&#xa;PHQ-2 (→ PHQ-9 si +) · GAD-2 (→ GAD-7 si +)&#xa;C-SSRS abreviada (ideación suicida)&#xa;Antecedentes de trauma / violencia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="1230" width="320" height="85" as="geometry"/></mxCell>
<mxCell id="n10" value="Factores de riesgo social:&#xa;red de apoyo, vivienda, violencia intrafamiliar&#xa;Si riesgo: notificar a Trabajo Social" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="1330" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="n11" value="Riesgo tromboembólico — Escala de Padua:&#xa;Si puntaje ≥ 4: considerar profilaxis&#xa;según criterio médico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="1430" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="n12" value="Registrar valores, creencias y costumbres&#xa;Identificar barreras para el aprendizaje&#xa;y necesidades educativas específicas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="1530" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="n13" value="Planeación temprana del alta:&#xa;identificar necesidades de apoyo domiciliario,&#xa;continuidad CE, trámites sociales / legales&#xa;Coordinar con TS y familia desde el ingreso" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="1630" width="320" height="85" as="geometry"/></mxCell>
<mxCell id="d3" value="¿Se requieren evaluaciones&#xa;especializadas adicionales?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="1730" width="320" height="80" as="geometry"/></mxCell>
<mxCell id="alt3" value="Emitir interconsultas:&#xa;Psicología, Nutrición, TS,&#xa;Medicina Interna u otro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="565" y="1735" width="235" height="65" as="geometry"/></mxCell>
<mxCell id="n14" value="Redactar nota de valoración inicial:&#xa;integrar todos los elementos evaluados&#xa;Documentar en expediente clínico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="1860" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="n15" value="Comunicar al paciente y familiar:&#xa;diagnóstico, plan de atención y pronóstico&#xa;Obtener firma «Registro Información a Familiares»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="1960" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="doc1" value="Nota de valoración inicial&#xa;firmada en expediente&#xa;(evidencia auditable)" style="shape=document;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#000000;fontColor=#000000;fontStyle=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="1870" width="165" height="55" as="geometry"/></mxCell>
<mxCell id="fin1" value="FIN" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="2060" width="140" height="50" as="geometry"/></mxCell>
